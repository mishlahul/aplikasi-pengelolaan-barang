generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    ADMIN
    OPERATOR
}

model User {
    id            Int            @id @default(autoincrement())
    role          Role
    username      String         @unique @db.VarChar(100)
    password      String         @db.VarChar(255)
    name          String         @db.VarChar(100)
    email         String         @unique @db.VarChar(100)
    isLocked      Boolean        @default(false) @map("is_locked")
    createdAt     DateTime       @default(now()) @map("created_at")
    updatedAt     DateTime       @updatedAt @map("updated_at")
    incomingItems IncomingItem[]

    @@map("users")
}

model Category {
    id            Int            @id @default(autoincrement())
    categoryCode  String         @unique @map("category_code") @db.VarChar(10)
    categoryName  String         @map("category_name") @db.VarChar(100)
    createdAt     DateTime       @default(now()) @map("created_at")
    updatedAt     DateTime       @updatedAt @map("updated_at")
    subCategories SubCategory[]
    incomingItems IncomingItem[]

    @@map("categories")
}

model SubCategory {
    id              Int            @id @default(autoincrement())
    categoryId      Int            @map("category_id")
    subCategoryName String         @map("sub_category_name") @db.VarChar(100)
    priceLimit      Decimal        @map("price_limit") @db.Decimal(15, 2)
    createdAt       DateTime       @default(now()) @map("created_at")
    updatedAt       DateTime       @updatedAt @map("updated_at")
    category        Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
    incomingItems   IncomingItem[]

    @@map("sub_categories")
}

model IncomingItem {
    id            Int                  @id @default(autoincrement())
    userId        Int                  @map("user_id")
    categoryId    Int                  @map("category_id")
    subCategoryId Int                  @map("sub_category_id")
    origin        String               @db.VarChar(200)
    letterNumber  String?              @map("letter_number") @db.VarChar(100)
    attachmentUrl String?              @map("attachment_url") @db.VarChar(255)
    createdAt     DateTime             @default(now()) @map("created_at")
    updatedAt     DateTime             @updatedAt @map("updated_at")
    user          User                 @relation(fields: [userId], references: [id])
    category      Category             @relation(fields: [categoryId], references: [id])
    subCategory   SubCategory          @relation(fields: [subCategoryId], references: [id])
    details       IncomingItemDetail[]

    @@map("incoming_items")
}

model IncomingItemDetail {
    id             Int          @id @default(autoincrement())
    incomingItemId Int          @map("incoming_item_id")
    itemName       String       @map("item_name") @db.VarChar(200)
    price          Decimal      @db.Decimal(15, 2)
    quantity       Int
    unit           String       @db.VarChar(40)
    total          Decimal      @db.Decimal(15, 2)
    isVerified     Boolean      @default(false) @map("is_verified")
    expiryDate     DateTime?    @map("expiry_date") @db.Date
    createdAt      DateTime     @default(now()) @map("created_at")
    updatedAt      DateTime     @updatedAt @map("updated_at")
    incomingItem   IncomingItem @relation(fields: [incomingItemId], references: [id], onDelete: Cascade)

    @@map("incoming_item_details")
}
